<?xml version="1.0" encoding="utf-8"?>
<!-- Backup automatico di Android fino ad Android 11 (decisione 93).
     Solo database e foto: niente cache, niente copie di sicurezza delle
     migrazioni (.bak). Le stesse regole sono in data_extraction_rules.xml. -->
<full-backup-content>
    <include domain="root" path="app_flutter/facilecards.sqlite" />
    <include domain="root" path="app_flutter/facilecards.sqlite-wal" />
    <include domain="root" path="app_flutter/facilecards.sqlite-journal" />
    <include domain="file" path="photos/" />
</full-backup-content>
